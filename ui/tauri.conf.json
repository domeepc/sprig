{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sprig",
  "version": "0.2.0",
  "identifier": "dev.sprig.ui",
  "build": { "frontendDist": "web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "sprig", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 560 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
